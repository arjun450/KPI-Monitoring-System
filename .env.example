# .env — Copy this to .env and fill in real values
# Never commit .env to GitHub!

DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/kpi_monitoring

# Optional email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENTS=manager@yourcompany.com,ops@yourcompany.com
